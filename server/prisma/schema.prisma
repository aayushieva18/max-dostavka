// Схема базы данных. Один источник правды о том, какие данные хранит сервер.
// Postgres в интернете (Neon) — переехали с локального файла SQLite, чтобы
// данные не терялись при переносе сервера на хостинг. Строка подключения
// (с паролем) — в server/.env, который не хранится в общем доступе.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Курьер — отдельный человек/бизнес со своим списком товаров и заказов,
// не видит и не пересекается с другими курьерами. У каждого курьера своя
// ссылка для покупателей (по slug) и свой пароль для входа на свой экран
// (ownerToken, сверяется в заголовке x-owner-token).
model Courier {
  id         Int        @id @default(autoincrement())
  // Публичный, не секретный кусок ссылки для покупателей: ?courier=<slug>.
  slug       String     @unique
  name       String
  // Секретный пароль для входа именно этого курьера — по нему же сервер
  // узнаёт, какого курьера показывать, отдельный slug для входа не нужен.
  ownerToken String     @unique
  // Стоимость доставки в рублях, 0 — бесплатно. У каждого курьера своя,
  // независимо от других (например, у Арюны бесплатно, у кого-то — платно).
  deliveryFee Int       @default(0)
  // Дата, до которой курьеру разрешён доступ (и витрина для его покупателей,
  // и его собственный экран) — null означает "без ограничения" (так у
  // Арюны, первого курьера в проекте). Новым курьерам скрипт создания
  // ставит срок на месяц вперёд; продлевать — отдельным скриптом.
  expiresAt  DateTime?
  createdAt  DateTime   @default(now())
  products   Product[]
  customers  Customer[]
  orders     Order[]
}

// Товар и остаток, доступный к заказу прямо сейчас.
model Product {
  id            Int         @id @default(autoincrement())
  courier       Courier     @relation(fields: [courierId], references: [id])
  courierId     Int
  name          String
  // Сколько доступно к заказу. Хозяйка обновляет перед выездом.
  // Уменьшается при каждом подтверждённом заказе, не может уйти в минус.
  availableQty  Int         @default(0)
  // Фото товара — хранится прямо в базе как data-url (сжатое на клиенте
  // перед отправкой), отдельное файловое хранилище не заводили ради одной
  // картинки на товар.
  imageUrl      String?
  orderItems    OrderItem[]
}

// Покупатель — идентифицируется по id в MAX (или случайному id браузера)
// в паре с конкретным курьером, чтобы имя/адрес/телефон подставлялись сами
// при повторном заказе именно У ЭТОГО курьера (DeviceStorage на клиенте это
// дублирует, сервер — вторая, надёжная копия тех же данных).
model Customer {
  id         Int      @id @default(autoincrement())
  courier    Courier  @relation(fields: [courierId], references: [id])
  courierId  Int
  maxUserId  String
  name       String
  address    String
  phone      String
  orders     Order[]
  updatedAt  DateTime @updatedAt

  @@unique([courierId, maxUserId])
}

enum OrderStatus {
  NEW          // только что оформлен
  ON_THE_WAY   // хозяйка выехала (по факту — просто "не выдан")
  DELIVERED    // хозяйка нажала "заказ выдал"
  PICKED_UP    // покупатель нажал "заказ забрал"
  CANCELLED    // отменён (курьером или самим покупателем, пока не выдан)
}

model Order {
  id          Int         @id @default(autoincrement())
  courier     Courier     @relation(fields: [courierId], references: [id])
  courierId   Int
  customer    Customer    @relation(fields: [customerId], references: [id])
  customerId  Int
  // Имя/адрес/телефон СНИМКОМ на момент именно этого заказа — не берём их
  // через customer напрямую, потому что у Customer это текущие данные и они
  // перезаписываются при каждом новом заказе того же покупателя (иначе все
  // его старые заказы в списке показывали бы последний введённый адрес).
  name        String
  address     String
  phone       String
  status      OrderStatus @default(NEW)
  // Снимок стоимости доставки на момент заказа — курьер мог поменять цену
  // позже, старые заказы не должны задним числом менять сумму.
  deliveryFee Int         @default(0)
  // Координаты точки доставки (адрес геокодируется на клиенте при оформлении
  // заказа и сохраняется, чтобы не гадать по текстовому адресу).
  lat         Float
  lon         Float
  items       OrderItem[]
  createdAt   DateTime    @default(now())
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   Int
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  quantity  Int
}
